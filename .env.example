# Copier en .env et compléter. Ce fichier n'est jamais commité.

# Clé de connexion : la même phrase est saisie dans l'app pour déchiffrer les données.
# 16 caractères minimum ; une phrase de plusieurs mots est conseillée (le dépôt est public).
IB_PASSPHRASE=

# Dossier du projet connect-bank (ses données sont lues dans <dossier>/out). Par défaut : ../connect-bank
# CONNECT_BANK_DIR=../connect-bank

# Dossier des données locales (règles récurrentes, sel de chiffrement, journaux). Par défaut : %APPDATA%\info-bank
# IB_DATA_DIR=

# Déploiement GitHub Pages : dépôt distant (par défaut : remote « origin » de ce dépôt) et branche
# DEPLOY_REMOTE=https://github.com/<utilisateur>/info-bank.git
# DEPLOY_BRANCH=gh-pages
